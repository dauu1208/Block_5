<% const isEdit = !!record; %>
<%- include('../partials/head', { title: (isEdit ? 'Sửa ' : 'Thêm ') + r.singular }) %>
<main class="container narrow">
  <%- include('_nav', { active: r.key }) %>
  <h1><%= isEdit ? 'Sửa' : 'Thêm' %> <%= r.singular %></h1>
  <% if (Object.keys(errors).length) { %><div class="alert error">Dữ liệu chưa hợp lệ, vui lòng kiểm tra lại (giá trị đã nhập được giữ nguyên).</div><% } %>

  <%# novalidate: để server kiểm tra và trả 400 %>
  <form method="post" novalidate class="form"
        action="<%= isEdit ? `/admin/${r.key}/${record.id}?_method=PATCH` : `/admin/${r.key}` %>">
    <% r.fields.forEach(f => { const v = values[f.name]; %>
      <div class="field <%= errors[f.name] ? 'has-error' : '' %>">
        <% if (f.type === 'checkbox') { %>
          <label class="check"><input type="checkbox" name="<%= f.name %>" <%= v ? 'checked' : '' %>> <%= f.label %></label>
        <% } else { %>
          <label for="<%= f.name %>"><%= f.label %></label>
          <% if (f.type === 'textarea') { %>
            <textarea id="<%= f.name %>" name="<%= f.name %>" rows="4"><%= v %></textarea>
          <% } else if (f.type === 'select') { %>
            <select id="<%= f.name %>" name="<%= f.name %>">
              <option value=""><%= f.placeholder || '— Không chọn —' %></option>
              <% options[f.name].forEach(o => { %>
                <option value="<%= o.value %>" <%= String(v) === o.value ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
          <% } else if (f.type === 'multiselect') { %>
            <select id="<%= f.name %>" name="<%= f.name %>" multiple size="6">
              <% options[f.name].forEach(o => { %>
                <option value="<%= o.value %>" <%= (v || []).includes(o.value) ? 'selected' : '' %>><%= o.label %></option>
              <% }) %>
            </select>
            <small class="muted">Giữ Ctrl/Cmd để chọn nhiều.</small>
          <% } else { %>
            <input type="text" id="<%= f.name %>" name="<%= f.name %>" value="<%= v %>" <%= f.inputmode ? `inputmode=${f.inputmode}` : '' %>>
          <% } %>
        <% } %>
        <% if (f.hint) { %><small class="muted"><%= f.hint %></small><% } %>
        <% if (errors[f.name]) { %><small class="error-text"><%= errors[f.name] %></small><% } %>
      </div>
    <% }) %>
    <div class="form-actions">
      <button class="btn"><%= isEdit ? 'Lưu thay đổi' : 'Thêm mới' %></button>
      <a href="/admin/<%= r.key %>">Hủy</a>
    </div>
  </form>
</main>
<%- include('../partials/foot') %>
